      "purpose": "Small daily-proxy sanity/backtest jobs"
    },
    {
      "id": "jnu_v22_daily_proxy_suite",
      "status": "active",
      "request_path": "suite_requests/*.json",
      "result_path": "suite_results/*.json",
      "report_path": "suite_reports/*.md",
      "purpose": "JNU V2.2 daily-proxy candidate screening"
    },
    {
      "id": "jnu_nautilus_second_engine",
      "status": "active",
      "request_path": "nautilus_requests/*.json",
      "result_path": "nautilus_results/*.json",
      "report_path": "nautilus_reports/*.md",
      "purpose": "Independent Nautilus event/order/fill replay for first-engine passes"
    },
    {
      "id": "news_sentiment_research",
      "status": "planned",
      "purpose": "Collect, deduplicate, timestamp, score and map news/events to research factors"
    },
    {
      "id": "taiwan_stock_v28_research",
      "status": "planned",
      "purpose": "Versioned Taiwan-stock V28 research and evidence packets"
    },
    {
      "id": "generic_research_workflow",
      "status": "planned",
      "purpose": "Template for future non-financial repeatable research workflows"
    },
    {
      "id": "jnu_v22_evidence_first_phase4",
      "status": "pre_registered",
      "purpose": "Literature-backed JNU factor/state research with no post-hoc rescue",
      "preregistration": "config/jnu_v22_evidence_first_preregistration.json"
    },
    {
      "id": "jnu_dynamic_price_discovery_pilot",
      "status": "active",
      "request_path": "dpd_requests/*.json",
      "result_path": "dpd_results/*.json",
      "report_path": "dpd_reports/*.md",
      "purpose": "Cloud-first preregistered Dynamic Price Discovery pilot; hard-fails promotion without OSE/SGX venue data",
      "preregistration": "config/jnu_v22_evidence_first_preregistration.json"
    }
