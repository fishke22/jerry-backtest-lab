{
  "version": "1.0",
  "as_of": "2026-09-08",
  "status": "FROZEN_STRUCTURED_TERM_EVIDENCE_ATTESTATION_PROTOCOL",
  "purpose": "Convert field-level explicit OSE/provider/KMS term evidence into a machine-verifiable provider-term readiness record without inferring permissions or copying confidential source text into the public repository.",
  "source_classes": [
    "OSE_WRITTEN_CONFIRMATION",
    "PROVIDER_WRITTEN_CONFIRMATION",
    "PRIVATE_CONTRACT",
    "PUBLIC_OFFICIAL_SNAPSHOT",
    "KMS_VENDOR_OFFICIAL_SNAPSHOT",
    "INTERNAL_DEPLOYMENT_ATTESTATION"
  ],
  "allowed_authorities": [
    "OSE",
    "MARKET_DATA_PROVIDER",
    "KMS_VENDOR",
    "INTERNAL_CONTROL_OWNER"
  ],
  "required_source_fields": [
    "evidence_id",
    "source_class",
    "authority",
    "source_uri",
    "source_document_path",
    "document_sha256",
    "captured_at_utc",
    "confidentiality"
  ],
  "required_claim_fields": [
    "field",
    "value",
    "evidence_ids",
    "locator",
    "explicitness",
    "reviewer_attestation"
  ],
  "claim_rules": {
    "explicitness_required": "EXPLICIT_TEXT",
    "reviewer_attestation_required": "EXPLICIT_TEXT_CONFIRMED",
    "source_document_path_must_be_external_to_public_repo": true,
    "source_document_sha256_must_match": true,
    "url_only_evidence_never_promotes_readiness": true,
    "conflicting_claims_fail_closed": true,
    "claims_may_only_target_provider_term_protocol_fields": true,
    "confidential_source_text_not_copied_to_attestation": true,
    "attestation_retains_only_source_hash_uri_locator_and_claim_value": true
  },
